# Active Spring profile: local or dev
SPRING_PROFILES_ACTIVE=dev

# Database
# Use the complete JDBC URL, including timezone and character encoding options.
DB_URL=jdbc:mysql://your-rds-host:3306/miraero?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# Redis
# On EC2, use 127.0.0.1 when Redis runs on the same instance.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# Key prefixes are optional. Keep the trailing colon when overriding them.
REDIS_REFRESH_TOKEN_PREFIX=refreshToken:
REDIS_MYDATA_TOKEN_PREFIX=mydata-token:

# JWT
# JWT_SECRET must be a sufficiently long Base64-encoded signing key.
JWT_SECRET=
# Token expiration time in seconds
JWT_ACCESS_TOKEN_EXPIRES_IN=3600
JWT_REFRESH_TOKEN_EXPIRES_IN=1209600

# Account number encryption
# Base64-encoded AES key used to encrypt account numbers
ACCOUNT_NUMBER_ENCRYPTION_KEY=

# CORS
# Separate multiple allowed origins with a comma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Financial Supervisory Service financial product API
FSS_API_KEY=
# The values below are optional when the defaults in application.properties are used.
FSS_API_BASE_URL=https://finlife.fss.or.kr
FSS_DEPOSIT_PATH=/finlifeapi/depositProductsSearch.json
FSS_SAVING_PATH=/finlifeapi/savingProductsSearch.json
FSS_TOP_FIN_GRP_NO=020000
FSS_FINANCIAL_COMPANY_CODE=
FSS_PAGE_NO=1

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_REASONING_EFFORT=low
OPENAI_MODERATION_ENABLED=false

# MyData server
# Use the mock server URL locally and the deployed server URL in dev.
MYDATA_API_BASE_URL=
MYDATA_CLIENT_SECRET=
MYDATA_AUTHORIZE_PATH=/mock/oauth/authorize
MYDATA_TOKEN_PATH=/mock/oauth/token
MYDATA_ACCOUNTS_PATH=/mock/accounts
MYDATA_TRANSACTIONS_PATH=/mock/transactions

# Youth Policy API
YOUTH_POLICY_API_KEY=
# The values below are optional when the defaults in application.properties are used.
YOUTH_POLICY_API_BASE_URL=https://www.youthcenter.go.kr
YOUTH_POLICY_PATH=/go/ythip/getPlcy
YOUTH_POLICY_PAGE_SIZE=10
