<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jejuro.miraero.domain.card.mapper.CardMapper">

    <select id="findCheckCardIdsByUserId" resultType="long">
        SELECT card_id
        FROM `card`
        WHERE user_id = #{userId}
        AND card_type = 'CHECK'
    </select>

</mapper>